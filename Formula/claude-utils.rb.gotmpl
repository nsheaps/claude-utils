# typed: false
# frozen_string_literal: true

class ClaudeUtils < Formula
  desc 'CLI utilities for Claude Code workflow management'
  homepage 'https://github.com/nsheaps/claude-utils'
  license 'MIT'

  # agent-plugin and agent-hook are native, self-contained binaries produced by
  # `bun build --compile` and shipped per-platform in the release tarballs. Everything
  # else in bin/ is platform-independent bash. No node/bun is needed at runtime.
  on_macos do
    if Hardware::CPU.arm?
      url 'https://github.com/nsheaps/claude-utils/releases/download/{{ .Env.Tag }}/claude-utils-darwin-arm64.tar.gz'
      sha256 '{{ .Env.SHA256_DARWIN_ARM64 }}'
    else
      url 'https://github.com/nsheaps/claude-utils/releases/download/{{ .Env.Tag }}/claude-utils-darwin-amd64.tar.gz'
      sha256 '{{ .Env.SHA256_DARWIN_AMD64 }}'
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url 'https://github.com/nsheaps/claude-utils/releases/download/{{ .Env.Tag }}/claude-utils-linux-arm64.tar.gz'
      sha256 '{{ .Env.SHA256_LINUX_ARM64 }}'
    else
      url 'https://github.com/nsheaps/claude-utils/releases/download/{{ .Env.Tag }}/claude-utils-linux-amd64.tar.gz'
      sha256 '{{ .Env.SHA256_LINUX_AMD64 }}'
    end
  end

  depends_on 'fzf'
  depends_on 'gum'

  def install
    # The release tarball's root IS the contents of bin/ (agent-hook, agent-plugin, the bash CLIs,
    # and lib/) — many top-level entries, so Homebrew does not strip a leading directory. Install
    # them all into #{bin}; lib/ lands at #{bin}/lib, where the bash CLIs source it via $SCRIPT_DIR.
    bin.install Dir['*']
  end

  test do
    assert_match 'ccresume', shell_output("#{bin}/ccresume --help 2>&1", 1)
    assert_match 'Usage: agent-plugin', shell_output("#{bin}/agent-plugin --help")
    assert_match 'Usage: agent-hook', shell_output("#{bin}/agent-hook --help")
  end
end
