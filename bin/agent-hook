// src/output.ts
function halt(reason) {
  return { continue: false, stopReason: reason };
}
function warnUser(warning) {
  return { continue: true, systemMessage: warning };
}
function allow(agentMessage, userMessage) {
  return decide("allow", agentMessage, userMessage);
}
function deny(agentMessage, userMessage) {
  return decide("deny", agentMessage, userMessage);
}
function decide(permissionDecision, agentMessage, userMessage) {
  const out = {
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision,
      permissionDecisionReason: agentMessage
    }
  };
  if (userMessage) out.systemMessage = userMessage;
  return out;
}
function post(agentMessage, userMessage, opts = {}) {
  const specific = { hookEventName: "PostToolUse" };
  if (agentMessage) specific.additionalContext = agentMessage;
  if (opts.replaceOutput !== void 0) specific.updatedToolOutput = opts.replaceOutput;
  const out = { hookSpecificOutput: specific };
  if (userMessage) out.systemMessage = userMessage;
  if (opts.warn) out.decision = "block";
  return out;
}
function render(output) {
  return `${JSON.stringify(output)}
`;
}

// src/export-input.ts
function shellQuote(value) {
  return `'${value.replaceAll("'", `'\\''`)}'`;
}
function shellVarName(path, prefix = "HOOK") {
  const body = path.join("_").replace(/([a-z0-9])([A-Z])/g, "$1_$2").toUpperCase().replace(/[^A-Z0-9_]/g, "_").replace(/^HOOK_/, "");
  const name = body ? `${prefix}_${body}` : prefix;
  const collapsed = name.replace(/_+/g, "_").replace(/_$/, "");
  return /^[A-Z_][A-Z0-9_]*$/.test(collapsed) ? collapsed : void 0;
}
var MAX_DEPTH = 3;
function flattenPayload(payload, prefix = "HOOK") {
  const out = [];
  const seen = /* @__PURE__ */ new Set();
  const push = (path, value) => {
    const name = shellVarName(path, prefix);
    if (!name || seen.has(name)) return;
    seen.add(name);
    out.push([name, value]);
  };
  const walk = (obj, path, depth) => {
    for (const [key, value] of Object.entries(obj)) {
      const childPath = [...path, key];
      if (value === null) {
        push(childPath, "");
      } else if (Array.isArray(value)) {
        push(childPath, JSON.stringify(value));
      } else if (typeof value === "object") {
        push(childPath, JSON.stringify(value));
        if (depth < MAX_DEPTH) walk(value, childPath, depth + 1);
      } else {
        push(childPath, String(value));
      }
    }
  };
  walk(payload, [], 1);
  return out;
}
var InvalidPayloadError = class extends Error {
  constructor(detail) {
    super(`Could not read the hook payload: ${detail}`);
    this.name = "InvalidPayloadError";
  }
};
function exportInput(raw, prefix = "HOOK") {
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch (e) {
    throw new InvalidPayloadError(e instanceof Error ? e.message : String(e));
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
    throw new InvalidPayloadError("expected a JSON object at the top level");
  }
  const pairs = flattenPayload(parsed, prefix);
  const lines = pairs.map(([name, value]) => `export ${name}=${shellQuote(value)}`);
  lines.push(`export ${prefix}_INPUT_JSON=${shellQuote(JSON.stringify(parsed))}`);
  return `${lines.join("\n")}
`;
}

// src/cli.ts
var HELP = `Usage: agent-hook <command> [args]

Emits the JSON a Claude Code hook answers with, on stdout. Every decision command exits 0 \u2014
blocking is expressed in the JSON, never by the exit status, because on a non-zero exit the
harness discards stdout and reads stderr instead.

Reading the payload:
  export-input "$HOOK_INPUT"
      Print shell \`export\` lines for the hook's stdin payload. Use it as:

        HOOK_INPUT="$(cat)"
        eval "$(agent-hook export-input "$HOOK_INPUT")"

      Sets HOOK_EVENT_NAME, HOOK_SESSION_ID, HOOK_CWD, HOOK_TOOL_NAME, and one variable per
      scalar in nested objects (HOOK_TOOL_INPUT_COMMAND, HOOK_TOOL_INPUT_FILE_PATH, ...).
      Nested objects are also available whole as JSON, plus HOOK_INPUT_JSON for the lot.
      HOOK_EVENT_NAME is what you echo back as hookEventName.

Decisions (use with exec, so the hook's exit status is this command's):
  halt "<reason>"
      Stop the agent. continue:false + stopReason. The user must act to resume.

  warn-user "<warning>"
      Warn the user and carry on. continue:true + systemMessage.

  allow "<for agent>" "<for user>"
      Permit a tool call. PreToolUse permissionDecision:allow.

  deny "<for agent>" "<for user>"
      Refuse a tool call. PreToolUse permissionDecision:deny. The agent-facing message is where
      the alternative to suggest goes \u2014 the model reads it.

  post [--warn] [--replace-output "<new output>"] "<for agent>" "<for user>"
      PostToolUse feedback; the tool has already run. The agent-facing message always goes in
      additionalContext, never in reason.
        --warn             make it actionable (decision:block) rather than informational
        --replace-output   replace the tool result the model sees (updatedToolOutput)

Options:
  -h, --help               show this help
`;
function parseArgs(argv) {
  const out = { warn: false, help: false, positional: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--warn") {
      out.warn = true;
    } else if (a === "--replace-output") {
      const value = argv[++i];
      if (value === void 0) throw new Error("--replace-output requires a value");
      out.replaceOutput = value;
    } else if (a.startsWith("--replace-output=")) {
      out.replaceOutput = a.slice("--replace-output=".length);
    } else if (a === "-h" || a === "--help") {
      out.help = true;
    } else if (a === "--") {
      out.positional.push(...argv.slice(i + 1));
      break;
    } else {
      out.positional.push(a);
    }
  }
  return out;
}
function main(argv, io) {
  let args;
  try {
    args = parseArgs(argv);
  } catch (e) {
    io.stderr.write(`ERROR: ${errText(e)}
`);
    return 2;
  }
  if (args.help || args.positional.length === 0) {
    io.stdout.write(HELP);
    return args.help ? 0 : 2;
  }
  const [command, ...rest] = args.positional;
  switch (command) {
    case "export-input":
      return doExportInput(rest, io);
    case "halt":
      return one(command, rest, io, (reason) => halt(reason));
    case "warn-user":
      return one(command, rest, io, (warning) => warnUser(warning));
    case "allow":
      return two(command, rest, io, (agentMsg, userMsg) => allow(agentMsg, userMsg));
    case "deny":
      return two(command, rest, io, (agentMsg, userMsg) => deny(agentMsg, userMsg));
    case "post":
      return two(
        command,
        rest,
        io,
        (agentMsg, userMsg) => post(agentMsg, userMsg, { warn: args.warn, replaceOutput: args.replaceOutput })
      );
    default:
      io.stderr.write(`ERROR: Unknown command ${JSON.stringify(command)}. Try --help.
`);
      return 2;
  }
}
function errText(e) {
  return e instanceof Error ? e.message : String(e);
}
function one(command, rest, io, build) {
  if (rest.length !== 1) {
    io.stderr.write(`ERROR: ${command} takes exactly one message. Quote it.
`);
    return 2;
  }
  io.stdout.write(render(build(rest[0])));
  return 0;
}
function two(command, rest, io, build) {
  if (rest.length < 1 || rest.length > 2) {
    io.stderr.write(
      `ERROR: ${command} takes a message for the agent and, optionally, one for the user. Quote them.
`
    );
    return 2;
  }
  io.stdout.write(render(build(rest[0], rest[1] ?? "")));
  return 0;
}
function doExportInput(rest, io) {
  if (rest.length !== 1) {
    io.stderr.write(
      `ERROR: export-input takes exactly one argument, the payload. Quote it: agent-hook export-input "$HOOK_INPUT"
`
    );
    return 2;
  }
  try {
    io.stdout.write(exportInput(rest[0]));
  } catch (e) {
    io.stderr.write(`ERROR: ${errText(e)}
`);
    return 1;
  }
  return 0;
}

