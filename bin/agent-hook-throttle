#!/usr/bin/env bash
# agent-hook-throttle - Debounce/throttle helper CLI for Claude Code hooks
#
# Claude Code PreToolUse hooks fire before every tool call. This CLI (and
# the sourceable bin/lib/agent-hook-throttle.sh it wraps) lets a hook
# avoid redoing expensive work on every single call by remembering when
# it last ran a named check, in a directory the caller chooses.
#
# Prefer sourcing bin/lib/agent-hook-throttle.sh directly from bash hooks.
# Use this CLI when the hook is written in a language that can't easily
# `source` a bash library (Python, Node, etc).
#
# Usage:
#   agent-hook-throttle should-run --key KEY --interval SECONDS --state-dir DIR [--force]
#   agent-hook-throttle record --key KEY --state-dir DIR
#   agent-hook-throttle seconds-since --key KEY --state-dir DIR
#   agent-hook-throttle --help
#
# should-run exits 0 ("run the check now") or 1 ("skip, still throttled").
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/agent-hook-throttle.sh"

show_help() {
  cat <<'EOF'
agent-hook-throttle - Debounce/throttle helper for Claude Code hook scripts

USAGE:
  agent-hook-throttle should-run --key KEY --interval SECONDS --state-dir DIR [--force]
  agent-hook-throttle record --key KEY --state-dir DIR
  agent-hook-throttle seconds-since --key KEY --state-dir DIR
  agent-hook-throttle --help

COMMANDS:
  should-run      Exit 0 if the throttled check should run now, exit 1 if
                  it should be skipped (still within the throttle window).
  record          Record that the check ran now (updates the timestamp).
  seconds-since   Print seconds since KEY was last recorded, or "never".

OPTIONS:
  --key KEY            Unique name for this throttled check (required)
  --interval SECONDS   Minimum seconds between runs (required for should-run,
                        unless --force is given)
  --state-dir DIR      Directory to persist the last-run timestamp (required)
  --force              Always allow should-run, bypassing the throttle.
                        Use for "definitely stale, must recheck now" cases
                        (e.g. a token already known to be expired).
  -h, --help           Show this help message

EXAMPLES:
  # Throttle an expensive .envrc re-check to once per 5 minutes:
  if agent-hook-throttle should-run --key envrc-check --interval 300 --state-dir "$CLAUDE_PLUGIN_DATA"; then
    check_envrc_state
    agent-hook-throttle record --key envrc-check --state-dir "$CLAUDE_PLUGIN_DATA"
  fi

  # A different hook can choose a different interval/key/state-dir --
  # throttle policy is always per-caller, never global.
  agent-hook-throttle should-run --key github-app-token --interval 300 --state-dir "$CLAUDE_PLUGIN_DATA"

REPOSITORY:
  https://github.com/nsheaps/claude-utils
EOF
}

KEY=""
INTERVAL=""
STATE_DIR=""
FORCE=false

parse_common_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --key)
      KEY="${2:-}"
      shift 2
      ;;
    --interval)
      INTERVAL="${2:-}"
      shift 2
      ;;
    --state-dir)
      STATE_DIR="${2:-}"
      shift 2
      ;;
    --force)
      FORCE=true
      shift
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    *)
      echo "agent-hook-throttle: unknown option: $1" >&2
      exit 2
      ;;
    esac
  done
}

require_arg() {
  local name="$1"
  local value="$2"
  if [[ -z "$value" ]]; then
    echo "agent-hook-throttle: --$name is required" >&2
    exit 2
  fi
}

COMMAND="${1:-}"
[[ $# -gt 0 ]] && shift

case "$COMMAND" in
should-run)
  parse_common_args "$@"
  require_arg "key" "$KEY"
  require_arg "state-dir" "$STATE_DIR"
  if [[ "$FORCE" == true ]]; then
    exit 0
  fi
  require_arg "interval" "$INTERVAL"
  if throttle_should_run "$KEY" "$INTERVAL" "$STATE_DIR"; then
    exit 0
  else
    exit 1
  fi
  ;;
record)
  parse_common_args "$@"
  require_arg "key" "$KEY"
  require_arg "state-dir" "$STATE_DIR"
  throttle_record "$KEY" "$STATE_DIR"
  ;;
seconds-since)
  parse_common_args "$@"
  require_arg "key" "$KEY"
  require_arg "state-dir" "$STATE_DIR"
  throttle_seconds_since "$KEY" "$STATE_DIR"
  ;;
-h | --help | "")
  show_help
  ;;
*)
  echo "agent-hook-throttle: unknown command: $COMMAND" >&2
  echo "Run 'agent-hook-throttle --help' for usage." >&2
  exit 2
  ;;
esac
