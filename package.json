{
  "name": "claude-utils",
  "version": "0.1.0",
  "private": true,
  "description": "CLI utilities for Claude Code workflow management",
  "repository": {
    "type": "git",
    "url": "https://github.com/nsheaps/claude-utils.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "format": "prettier --write \"packages/**/*.{ts,mjs}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"packages/**/*.{ts,mjs}\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "~24.13.3",
    "esbuild": "~0.25.10",
    "nx": "~23.0.1",
    "oxlint": "~1.73.0",
    "prettier": "~3.6.2",
    "release-it": "^20.2.1",
    "typescript": "~7.0.2"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "engines": {
    "node": ">=22"
  }
}
